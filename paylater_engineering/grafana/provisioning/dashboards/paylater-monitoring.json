{
  "title": "PayLater Monitoring",
  "uid": "paylater-monitoring",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Drift detected",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(paylater_drift_detected)", "legendFormat": "drift"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Drift status by feature",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [
        {"expr": "paylater_drift_detected", "legendFormat": "{{task}} / {{feature}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Action outcomes",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum by (action, status) (increase(paylater_action_outcomes_total[15m]))", "legendFormat": "{{action}} / {{status}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by (method, path, status) (increase(paylater_http_requests_total[5m]))", "legendFormat": "{{method}} {{path}} {{status}}"}
      ]
    }
  ]
}
